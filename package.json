{
  "name": "peek-and-find",
  "version": "0.1.0",
  "private": true,
  "description": "Peek & Find — text-free hidden-object game for YouTube Playables (Pebblit)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/audit-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit -p tsconfig.json && eslint . && prettier --check .",
    "format": "prettier --write .",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@playgama/bridge": "2.3.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
