{
  "name": "peek-and-find",
  "version": "0.1.0",
  "private": true,
  "description": "Peek & Find \u2014 text-free hidden-object game for YouTube Playables (Pebblit)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-url.mjs && vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/audit-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit -p tsconfig.json && eslint . && prettier --check .",
    "format": "prettier --write .",
    "size": "node scripts/size.mjs",
    "assets": "node scripts/assets.mjs",
    "assets:check": "node scripts/assets.mjs --check",
    "audio": "node scripts/audio.mjs",
    "audio:check": "node scripts/audio.mjs --check",
    "dev:url": "node scripts/dev-url.mjs",
    "build:test": "npm run build && node scripts/build-test.mjs && node scripts/audit-dist.mjs",
    "e2e": "npm run build:test && playwright test",
    "e2e:only": "playwright test"
  },
  "dependencies": {
    "@playgama/bridge": "2.3.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
